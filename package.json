{
  "name": "oh-my-pi",
  "displayName": "Oh My Pi",
  "description": "Chat with the omp coding agent inside VS Code: streaming replies, tool cards, diffs, model picker and every omp setting.",
  "version": "0.30.0",
  "publisher": "khanhd1nh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KhanhD1nh/oh-my-pi-vscode"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:ohMyPi.panel"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ohMyPi",
          "title": "OMP",
          "icon": "media/pi.svg"
        }
      ]
    },
    "views": {
      "ohMyPi": [
        {
          "type": "webview",
          "id": "ohMyPi.chat",
          "name": ""
        }
      ]
    },
    "commands": [
      {
        "command": "ohMyPi.newSession",
        "title": "Oh My Pi: New Tab",
        "icon": "$(add)"
      },
      {
        "command": "ohMyPi.history",
        "title": "Oh My Pi: Session History",
        "icon": "$(history)"
      },
      {
        "command": "ohMyPi.settings",
        "title": "Oh My Pi: Settings",
        "icon": "$(gear)"
      },
      {
        "command": "ohMyPi.focus",
        "title": "OMP: Open Chat",
        "icon": {
          "light": "media/pi-tab.svg",
          "dark": "media/pi-tab.svg"
        }
      },
      {
        "command": "ohMyPi.addSelection",
        "title": "Oh My Pi: Add Selection to Chat"
      },
      {
        "command": "ohMyPi.checkForUpdates",
        "title": "OMP: Check for Updates"
      },
      {
        "command": "ohMyPi.send.selection",
        "title": "OMP: Send Selection or File",
        "icon": "$(selection)",
        "category": "OMP"
      },
      {
        "command": "ohMyPi.send.problems",
        "title": "OMP: Send Problems in File",
        "icon": "$(warning)",
        "category": "OMP"
      },
      {
        "command": "ohMyPi.send.workspaceProblems",
        "title": "OMP: Send Problems in Workspace",
        "icon": "$(warning)",
        "category": "OMP"
      },
      {
        "command": "ohMyPi.send.gitDiff",
        "title": "OMP: Send Uncommitted Changes of File",
        "icon": "$(git-compare)",
        "category": "OMP"
      },
      {
        "command": "ohMyPi.send.openTabs",
        "title": "OMP: Send Open Tabs",
        "icon": "$(files)",
        "category": "OMP"
      },
      {
        "command": "ohMyPi.send.symbol",
        "title": "OMP: Send Function/Class at Cursor",
        "icon": "$(symbol-method)",
        "category": "OMP"
      },
      {
        "command": "ohMyPi.send.files",
        "title": "OMP: Send to OMP",
        "icon": "$(send)",
        "category": "OMP"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ohMyPi.newSession",
          "when": "view == ohMyPi.chat",
          "group": "navigation@0"
        },
        {
          "command": "ohMyPi.settings",
          "when": "view == ohMyPi.chat",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "submenu": "ohMyPi.send",
          "group": "ohMyPi@1"
        }
      ],
      "editor/title": [
        {
          "command": "ohMyPi.focus",
          "when": "config.ohMyPi.editorButton && activeWebviewPanelId != 'ohMyPi.panel'",
          "group": "navigation@-100"
        },
        {
          "command": "ohMyPi.newSession",
          "when": "activeWebviewPanelId == 'ohMyPi.panel'",
          "group": "navigation@0"
        },
        {
          "command": "ohMyPi.history",
          "when": "activeWebviewPanelId == 'ohMyPi.panel'",
          "group": "navigation@1"
        },
        {
          "command": "ohMyPi.settings",
          "when": "activeWebviewPanelId == 'ohMyPi.panel'",
          "group": "navigation@2"
        }
      ],
      "ohMyPi.send": [
        {
          "command": "ohMyPi.send.selection",
          "group": "1_code@1"
        },
        {
          "command": "ohMyPi.send.symbol",
          "group": "1_code@2"
        },
        {
          "command": "ohMyPi.send.problems",
          "group": "2_info@1"
        },
        {
          "command": "ohMyPi.send.gitDiff",
          "group": "2_info@2"
        },
        {
          "command": "ohMyPi.send.openTabs",
          "group": "3_more@1"
        },
        {
          "command": "ohMyPi.send.workspaceProblems",
          "group": "3_more@2"
        }
      ],
      "explorer/context": [
        {
          "command": "ohMyPi.send.files",
          "when": "!explorerResourceIsFolder || explorerResourceIsFolder",
          "group": "ohMyPi@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ohMyPi.send.files",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ohMyPi.focus",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p"
      },
      {
        "command": "ohMyPi.addSelection",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorHasSelection"
      },
      {
        "command": "ohMyPi.send.selection",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o",
        "when": "editorTextFocus"
      },
      {
        "command": "ohMyPi.send.problems",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Oh My Pi",
      "properties": {
        "ohMyPi.command": {
          "type": "string",
          "default": "omp",
          "description": "omp executable (name on PATH or absolute path). Installed automatically when missing."
        },
        "ohMyPi.compact": {
          "type": "boolean",
          "default": false,
          "description": "Denser chat: tighter tool steps and smaller text, for small screens."
        },
        "ohMyPi.notifyOnDone": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a chat finishes while its tab is not in front."
        },
        "ohMyPi.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Check GitHub Releases once a day and offer to install a newer OMP extension."
        },
        "ohMyPi.editorButton": {
          "type": "boolean",
          "default": true,
          "description": "Show the π button on every editor title bar to open OMP beside it."
        },
        "ohMyPi.statusBarButton": {
          "type": "boolean",
          "default": true,
          "description": "Show an OMP button in the status bar (shows running chats)."
        },
        "ohMyPi.goal.maxTurns": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Goal mode: stop after this many turns (resume adds more)."
        },
        "ohMyPi.goal.maxCost": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Goal mode: stop after spending this many USD on the goal (0 = no limit)."
        }
      }
    },
    "submenus": [
      {
        "id": "ohMyPi.send",
        "label": "Send to OMP"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "node test/run.mjs",
    "package": "node build.mjs && vsce package --no-dependencies",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@10.20.0"
}
